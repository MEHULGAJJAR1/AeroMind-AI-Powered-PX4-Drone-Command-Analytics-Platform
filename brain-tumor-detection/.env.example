# Copy to `.env` and adjust. All keys are optional — sensible defaults apply.
# Copy with:  cp .env.example .env

# --- Flask -----------------------------------------------------------------
# development | production | testing
BTD_ENV=development
BTD_SECRET_KEY=change-me-to-a-long-random-string
BTD_HOST=0.0.0.0
BTD_PORT=5000
# 1 enables the Werkzeug reloader and debugger (development only)
BTD_DEBUG=0
# Comma-separated list of allowed origins for browser clients, e.g.
# BTD_CORS_ORIGINS=http://localhost:3000,https://scan.example.com
BTD_CORS_ORIGINS=

# --- Model -----------------------------------------------------------------
# Directory that holds model.pt (+ optional model_scripted.pt and metadata.json)
BTD_MODEL_DIR=data/models
# auto | cpu | cuda | mps
BTD_DEVICE=auto
# Fail fast on boot when no checkpoint is found instead of serving degraded mode
BTD_REQUIRE_MODEL=0

# --- Upload limits ---------------------------------------------------------
# Megabytes
BTD_MAX_UPLOAD_MB=10
# Minimum accepted pixel dimension after EXIF orientation is applied
BTD_MIN_IMAGE_DIMENSION=32
# Guard against decompression bombs (total pixels)
BTD_MAX_IMAGE_PIXELS=89478485

# --- Storage / history -----------------------------------------------------
BTD_DATA_DIR=data
BTD_DB_PATH=data/history.db
# Keep uploaded originals + thumbnails (0 disables storage, history keeps metadata only)
BTD_KEEP_UPLOADS=1
# Maximum number of history rows kept (older rows are pruned); 0 keeps everything
BTD_HISTORY_LIMIT=500

# --- Rate limiting ---------------------------------------------------------
# Requests per window per client IP; set BTD_RATE_LIMIT=0 to disable
BTD_RATE_LIMIT=60
BTD_RATE_WINDOW_SECONDS=60

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
BTD_LOG_LEVEL=INFO
BTD_LOG_FILE=
