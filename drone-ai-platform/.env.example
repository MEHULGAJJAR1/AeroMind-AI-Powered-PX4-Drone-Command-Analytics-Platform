# Copy to .env for local development. Generate secrets locally; this file is not a credential.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./data/aeromind.db
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_BACKEND_TARGET=http://127.0.0.1:8000
ALLOW_REGISTRATION=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# mock is ready to run without a simulator. Use px4 only when PX4 SITL/MAVLink is available.
TELEMETRY_MODE=mock
PX4_SYSTEM_ADDRESS=udp://:14540
MAVSDK_SERVER_ADDRESS=127.0.0.1
MAVSDK_SERVER_PORT=50051
PX4_CONNECT_TIMEOUT_S=15
RECONNECT_BACKOFF_MAX_S=30
MOCK_TICK_SECONDS=1
TELEMETRY_PERSIST_INTERVAL_S=2
SAFE_MAX_ALTITUDE_M=120
SAFE_MAX_SPEED_M_S=25
MAX_MISSION_WAYPOINTS=100

# Required by docker-compose.yml. Choose a strong unique value before running Compose.
POSTGRES_USER=aeromind
POSTGRES_PASSWORD=
POSTGRES_DB=aeromind
